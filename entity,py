from typing import Tuple

class Entity:
    def __init__(self, x: int, y: int, glyph: str, colour: Tuple[int, int, int]):
        self.x = x
        self.y = y
        self.glyph = glyph
        self.colour = colour

    def move(self, dx:int, dy:int) -> None:
        self.x +=dx
        self.y +=dy      